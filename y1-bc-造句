                { id: 'a25', text: '找宝藏', type: 'action', color: 'bg-red-100 border-red-400 text-red-700', icon: '💎' },
                { id: 'a26', text: '变魔术', type: 'action', color: 'bg-red-100 border-red-400 text-red-700', icon: '🎩' },
                { id: 'a27', text: '飞向天空', type: 'action', color: 'bg-red-100 border-red-400 text-red-700', icon: '🚀' },
                { id: 'a28', text: '跳绳', type: 'action', color: 'bg-red-100 border-red-400 text-red-700', icon: '🪢' },
                { id: 'a29', text: '探险', type: 'action', color: 'bg-red-100 border-red-400 text-red-700', icon: '🧭' },
                { id: 'a30', text: '做梦', type: 'action', color: 'bg-red-100 border-red-400 text-red-700', icon: '🌛' },
            ]
        };

        const ITEMS_PER_PAGE = 6;
        const TOTAL_PAGES = 5;

        function App() {
            const [trainSlots, setTrainSlots] = useState([null, null, null, null]);
            const [draggedItem, setDraggedItem] = useState(null);
            const [selectedItem, setSelectedItem] = useState(null);
            
            const [pageIndices, setPageIndices] = useState({ time: 0, who: 0, place: 0, action: 0 });

            const [availableNumbers, setAvailableNumbers] = useState(Array.from({length: 36}, (_, i) => i + 1));
            const [drawOverlay, setDrawOverlay] = useState({ isVisible: false, phase: 'idle', displayNum: null });

            // 语音状态管理：'idle', 'loading', 'playing'
            const [ttsStatus, setTtsStatus] = useState('idle');
            const [audioObj, setAudioObj] = useState(null);

            const handleDrawNumber = () => {
                if (availableNumbers.length === 0) {
                    setAvailableNumbers(Array.from({length: 36}, (_, i) => i + 1));
                    return;
                }
                setDrawOverlay({ isVisible: true, phase: 'shuffling', displayNum: '?' });
                let shuffleCount = 0;
                const shuffleInterval = setInterval(() => {
                    setDrawOverlay(prev => ({ ...prev, displayNum: Math.floor(Math.random() * 36) + 1 }));
                    shuffleCount++;
                    if (shuffleCount > 15) {
                        clearInterval(shuffleInterval);
                        const randomIndex = Math.floor(Math.random() * availableNumbers.length);
                        const finalNumber = availableNumbers[randomIndex];
                        setAvailableNumbers(prev => prev.filter(n => n !== finalNumber));
                        setDrawOverlay({ isVisible: true, phase: 'result', displayNum: finalNumber });
                        setTimeout(() => { setDrawOverlay({ isVisible: false, phase: 'idle', displayNum: null }); }, 2500);
                    }
                }, 100);
            };

            const handleRefreshCategory = (category) => {
                setPageIndices(prev => ({ ...prev, [category]: (prev[category] + 1) % TOTAL_PAGES }));
            };

            const formatSentence = (slots, isDisplay = false) => {
                const filledCount = slots.filter(Boolean).length;
                if (filledCount === 0) return isDisplay ? '等待拼凑句子...' : '';

                let sentenceParts = [];
                slots.forEach((slot, index) => {
                    if (!slot) { if (isDisplay) sentenceParts.push(' ___ '); return; }
                    let text = slot.text;
                    if (slot.type === 'place' && !text.startsWith('在')) { text = '在' + text; }
                    if ((slot.type === 'time' || slot.type === 'place') && index === 0 && filledCount > 1) { text += '，'; }
                    sentenceParts.push(text);
                });
                return sentenceParts.join('') + (isDisplay && filledCount > 0 ? '。' : '');
            };

            // 停止当前所有语音播放
            const stopAudio = () => {
                if (audioObj) {
                    audioObj.pause();
                    audioObj.currentTime = 0;
                    setAudioObj(null);
                }
                window.speechSynthesis.cancel();
                setTtsStatus('idle');
            };

            // 备用的本地语音引擎（当 AI 引擎网络不可用时自动启用）
            const fallbackTTS = (text) => {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'zh-CN';
                utterance.rate = 0.95; // 稍微提速，使其听起来更加自然流畅
                utterance.pitch = 1.1; 
                
                // 尽力寻找本地好听的语音
                const voices = window.speechSynthesis.getVoices();
                const preferredNames = ['Xiaoxiao', 'Yaoyao', 'Ting-Ting', 'Google 普通话', 'Microsoft', 'Baidu'];
                let bestVoice = null;
                for (let name of preferredNames) {
                    bestVoice = voices.find(v => v.name.includes(name) && (v.lang.includes('zh') || v.lang.includes('cmn')));
                    if (bestVoice) break;
                }
                if (!bestVoice) {
                    bestVoice = voices.find(v => v.lang.includes('zh') || v.lang.includes('cmn'));
                }
                if (bestVoice) utterance.voice = bestVoice;

                utterance.onstart = () => setTtsStatus('playing');
                utterance.onend = () => setTtsStatus('idle');
                utterance.onerror = () => setTtsStatus('idle');

                window.speechSynthesis.speak(utterance);
            };

            // 核心：请求极其逼真的 AI 拟人语音引擎
            const speakSentenceAI = async () => {
                const text = formatSentence(trainSlots, false);
                if (!text) return;

                // 如果正在播放或正在加载，点击则停止
                if (ttsStatus === 'playing' || ttsStatus === 'loading') {
                    stopAudio();
                    return;
                }

                setTtsStatus('loading');
                try {
                    // API Key 已经填入
                    const apiKey = "AIzaSyBukWfXmnvY7pEkpwfowGR3LJ40248jSSM"; 
                    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent?key=${apiKey}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            // 修改：去掉“慢慢地”，让声音更自然流畅
                            contents: [{ parts: [{ text: `用温柔、自然流畅的语气，像幼教老师给小朋友讲故事一样，生动地读出这句话：${text}` }] }],
                            generationConfig: {
                                responseModalities: ["AUDIO"],
                                speechConfig: {
                                    voiceConfig: {
                                        prebuiltVoiceConfig: { voiceName: "Aoede" } // 挑选的拟人化女声
                                    }
                                }
                            },
                            model: "gemini-2.5-flash-preview-tts"
                        })
                    });

                    if (!response.ok) throw new Error("API Connection Failed");

                    const data = await response.json();
                    const inlineData = data.candidates?.[0]?.content?.parts?.[0]?.inlineData;

                    if (inlineData) {
                        const base64Data = inlineData.data;
                        const binaryString = window.atob(base64Data);
                        const len = binaryString.length;
                        const bytes = new Uint8Array(len);
                        for (let i = 0; i < len; i++) {
                            bytes[i] = binaryString.charCodeAt(i);
                        }

                        const mimeType = inlineData.mimeType;
                        const rateMatch = mimeType.match(/rate=(\d+)/);
                        const sampleRate = rateMatch ? parseInt(rateMatch[1], 10) : 24000;

                        const wavBuffer = pcmToWav(bytes, sampleRate);
                        const blob = new Blob([wavBuffer], { type: 'audio/wav' });
                        const url = URL.createObjectURL(blob);
                        
                        const audio = new Audio(url);
                        setAudioObj(audio);
                        
                        audio.onended = () => setTtsStatus('idle');
                        audio.onerror = () => {
                            console.error("Audio playback error");
                            fallbackTTS(text);
                        };
                        
                        audio.play();
                        setTtsStatus('playing');
                    } else {
                        throw new Error("No audio data returned");
                    }
                } catch (err) {
                    console.log("AI voice service unavailable, falling back to local TTS engine.");
                    fallbackTTS(text);
                }
            };

            // 获取随机花式夸奖
            const getSuccessMessage = (slots) => {
                const MESSAGES = [
                    "太棒了！这是最自然、最好听的魔法句子！满分！",
                    "完美！你简直是个造句小天才，给你点赞！",
                    "哇，这个句子拼得太顺口啦！你真棒！",
                    "太厉害了！这句话听起来就像童话故事一样美！",
                    "100分！你把积木排得刚刚好，句子真好听！",
                    "非常棒！你的语感真好，这句话读起来太自然了！"
                ];
                // 使用组合里的卡片ID来稳定挑选夸奖（保证同一个句子提示稳定，换新句子会变）
                const idString = slots.map(s => s.id).join('');
                let hash = 0;
                for (let i = 0; i < idString.length; i++) {
                    hash = idString.charCodeAt(i) + ((hash << 5) - hash);
                }
                const index = Math.abs(hash) % MESSAGES.length;
                return MESSAGES[index];
            };

            const getFeedback = () => {
                const filledSlots = trainSlots.filter(s => s !== null);
                if (filledSlots.length < 4) return { text: "拖拽上方的词语，或者点击词语再点击车厢，拼出你的句子吧！", type: "neutral", icon: <Sparkles className="w-5 h-5 text-purple-500" /> };
                
                const pattern = trainSlots.map(s => s.type).join('-');
                if (pattern === 'time-who-place-action' || pattern === 'who-time-place-action') {
                    // 当拼成完美句子时，随机挑选一句夸奖
                    return { text: getSuccessMessage(filledSlots), type: "success", icon: <CheckCircle2 className="w-5 h-5 text-green-500" /> };
                }
                if (pattern === 'time-place-who-action') return { text: "拼得不错！但听起来像新闻播报。试试把蓝色的“人”和绿色的“地点”互换位置看看？", type: "hint", icon: <AlertCircle className="w-5 h-5 text-orange-500" /> };
                if (pattern.startsWith('action') || pattern.includes('action-time') || pattern.includes('action-place')) return { text: "哎呀，动作怎么跑到前面去啦？句子读起来好奇怪，再重新排排队吧！", type: "warning", icon: <AlertCircle className="w-5 h-5 text-red-500" /> };
                return { text: "组装完成！不过读起来稍微有点不太顺口，你能把它改成最棒的顺序吗？", type: "hint", icon: <Sparkles className="w-5 h-5 text-blue-500" /> };
            };

            const feedback = getFeedback();

            const handleDragStart = (e, item, sourceIndex = null, source = 'bank') => {
                setDraggedItem({ item, sourceIndex, source });
                setTimeout(() => e.target.classList.add('opacity-50'), 0);
            };

            const handleDragEnd = (e) => { e.target.classList.remove('opacity-50'); setDraggedItem(null); };
            const handleDragOver = (e) => { e.preventDefault(); };
            
            const handleDrop = (e, targetIndex) => {
                e.preventDefault();
                if (!draggedItem) return;
                handleItemMove(draggedItem.item, draggedItem.sourceIndex, targetIndex, draggedItem.source);
                setDraggedItem(null);
            };

            const handleItemClick = (item, index = null, source = 'bank') => {
                if (selectedItem && source === 'slot') {
                    handleItemMove(selectedItem.item, selectedItem.sourceIndex, index, selectedItem.source);
                    setSelectedItem(null);
                } else {
                    if (selectedItem?.item.id === item.id && selectedItem?.source === source && selectedItem?.sourceIndex === index) {
                        setSelectedItem(null);
                    } else {
                        setSelectedItem({ item, sourceIndex: index, source });
                    }
                }
            };

            const handleEmptySlotClick = (targetIndex) => {
                if (selectedItem) {
                    handleItemMove(selectedItem.item, selectedItem.sourceIndex, targetIndex, selectedItem.source);
                    setSelectedItem(null);
                }
            };

            const handleItemMove = (item, sourceIndex, targetIndex, source) => {
                const newSlots = [...trainSlots];
                if (source === 'bank') {
                    const existingIndex = newSlots.findIndex(slot => slot?.id === item.id);
                    if (existingIndex !== -1) newSlots[existingIndex] = null;
                    newSlots[targetIndex] = item;
                } else if (source === 'slot') {
                    const temp = newSlots[targetIndex];
                    newSlots[targetIndex] = newSlots[sourceIndex];
                    newSlots[sourceIndex] = temp;
                }
                setTrainSlots(newSlots);
            };

            const resetTrain = () => {
                setTrainSlots([null, null, null, null]);
                setSelectedItem(null);
                stopAudio();
            };

            const renderCard = (word, source = 'bank', index = null) => {
                const isUsed = trainSlots.some(slot => slot?.id === word.id);
                const isSelected = selectedItem?.item.id === word.id && selectedItem?.source === source && selectedItem?.sourceIndex === index;
                return (
                    <div key={word.id} draggable={!isUsed || source === 'slot'} onDragStart={(e) => handleDragStart(e, word, index, source)} onDragEnd={handleDragEnd} onClick={() => (!isUsed || source === 'slot') && handleItemClick(word, index, source)}
                        className={`flex flex-col items-center justify-center p-1 md:p-1.5 rounded-xl border-2 cursor-pointer transition-all duration-200 transform ${word.color} bg-white ${(isUsed && source === 'bank') ? 'opacity-30 cursor-not-allowed grayscale' : 'hover:scale-105 hover:shadow-md'} ${isSelected ? 'ring-4 ring-purple-400 scale-105 shadow-lg' : ''} ${source === 'slot' ? 'w-full h-full shadow-sm' : 'w-full aspect-square max-w-[4rem] md:max-w-[4.5rem] shadow-sm'}`}
                    >
                        <span className={`${source === 'slot' ? 'text-2xl md:text-3xl' : 'text-lg md:text-xl'} mb-0.5`}>{word.icon}</span>
                        <span className={`font-bold text-center leading-tight ${source === 'slot' ? 'text-sm md:text-base' : 'text-[10px] md:text-xs'}`}>{word.text}</span>
                    </div>
                );
            };

            const renderWordPage = (category) => {
                const startIndex = pageIndices[category] * ITEMS_PER_PAGE;
                const currentWords = WORD_BANK[category].slice(startIndex, startIndex + ITEMS_PER_PAGE);
                return currentWords.map(word => renderCard(word, 'bank'));
            };

            return (
                <div className="min-h-screen bg-[#FFFBF0] text-gray-800 p-2 md:p-4 font-sans flex flex-col selection:bg-purple-200 overflow-y-auto pb-10">
                    {drawOverlay.isVisible && (
                        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm transition-opacity duration-300">
                            <div className="flex flex-col items-center">
                                {drawOverlay.phase === 'shuffling' && (
                                    <React.Fragment>
                                        <div className="text-white text-2xl md:text-4xl font-bold mb-4 animate-pulse">正在抽取幸运儿...</div>
                                        <div className="w-40 h-40 md:w-64 md:h-64 bg-white/20 rounded-full flex items-center justify-center border-4 border-dashed border-purple-400 animate-spin-slow">
                                            <div className="text-7xl md:text-9xl font-black text-yellow-300 animate-bounce" style={{ animationDuration: '0.2s' }}>{drawOverlay.displayNum}</div>
                                        </div>
                                    </React.Fragment>
                                )}
                                {drawOverlay.phase === 'result' && (
                                    <div className="flex flex-col items-center spring-bounce">
                                        <div className="text-yellow-300 text-3xl md:text-5xl font-black mb-6 drop-shadow-[0_0_15px_rgba(253,224,71,0.8)] tracking-widest">✨ 幸运数字 ✨</div>
                                        <div className="bg-gradient-to-br from-yellow-300 via-orange-400 to-red-500 rounded-3xl p-2 md:p-4 shadow-[0_0_40px_rgba(249,115,22,0.6)] transform hover:scale-105 transition-transform">
                                            <div className="bg-white rounded-2xl w-48 h-48 md:w-72 md:h-72 flex flex-col items-center justify-center border-8 border-white border-opacity-50">
                                                <span className="text-gray-500 text-lg md:text-2xl font-bold mb-2">请几号来拼句子呢？</span>
                                                <span className="text-8xl md:text-[10rem] font-black text-transparent bg-clip-text bg-gradient-to-br from-red-500 to-purple-600 leading-none">{drawOverlay.displayNum}</span>
                                            </div>
                                        </div>
                                        <div className="mt-8 text-white text-xl animate-pulse">请准备上台！</div>
                                    </div>
                                )}
                            </div>
                        </div>
                    )}

                    <div className="max-w-5xl mx-auto w-full text-center mb-2 md:mb-4 flex-shrink-0 relative">
                        <h1 className="text-2xl md:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-purple-400 to-pink-400 mb-1 drop-shadow-sm">神奇句子小火车</h1>
                        <p className="text-xs md:text-sm text-gray-500 font-medium bg-white inline-block px-3 py-1 rounded-full shadow-sm border border-orange-100">把积木放到小火车里，点击“换一批”发现更多惊喜词语！</p>
                        <div className="absolute top-0 right-0 flex flex-col items-end z-20">
                            <button onClick={handleDrawNumber} disabled={drawOverlay.isVisible} className="flex items-center gap-1 bg-gradient-to-r from-pink-400 to-purple-500 hover:from-pink-500 hover:to-purple-600 text-white px-3 py-1.5 md:px-4 md:py-2 rounded-full shadow-md font-bold transition-transform active:scale-95 disabled:opacity-70 text-xs md:text-sm">
                                <Ticket className={`w-4 h-4 md:w-5 md:h-5 ${drawOverlay.isVisible ? 'animate-bounce' : ''}`} />
                                {availableNumbers.length === 0 ? '重新洗牌' : '幸运抽签'}
                            </button>
                            {availableNumbers.length > 0 && availableNumbers.length < 36 && ( <span className="text-[10px] text-gray-400 mt-1 font-medium bg-white/60 px-1.5 py-0.5 rounded-full shadow-sm">剩余: {availableNumbers.length}/36</span> )}
                        </div>
                    </div>

                    <div className="max-w-5xl mx-auto w-full grid grid-cols-2 md:grid-cols-4 gap-2 md:gap-4 mb-2 md:mb-4 flex-shrink-0">
                        <div className="bg-yellow-50 rounded-2xl p-2 md:p-3 border-t-8 border-yellow-300 shadow-sm flex flex-col items-center">
                            <div className="w-full flex items-center justify-between mb-2">
                                <h2 className="text-yellow-700 text-sm font-bold bg-yellow-200 px-3 py-0.5 rounded-full">时间</h2>
                                <button onClick={() => handleRefreshCategory('time')} className="flex items-center gap-1 text-[10px] md:text-xs text-yellow-700 bg-yellow-100 hover:bg-yellow-200 px-2 py-1 rounded-full transition-colors font-bold shadow-sm active:scale-95"><RefreshCw className="w-3 h-3" /> 换一批</button>
                            </div>
                            <div className="grid grid-cols-2 gap-1.5 w-full place-items-center">{renderWordPage('time')}</div>
                        </div>
                        <div className="bg-blue-50 rounded-2xl p-2 md:p-3 border-t-8 border-blue-300 shadow-sm flex flex-col items-center">
                            <div className="w-full flex items-center justify-between mb-2">
                                <h2 className="text-blue-700 text-sm font-bold bg-blue-200 px-3 py-0.5 rounded-full">谁/什么</h2>
                                <button onClick={() => handleRefreshCategory('who')} className="flex items-center gap-1 text-[10px] md:text-xs text-blue-700 bg-blue-100 hover:bg-blue-200 px-2 py-1 rounded-full transition-colors font-bold shadow-sm active:scale-95"><RefreshCw className="w-3 h-3" /> 换一批</button>
                            </div>
                            <div className="grid grid-cols-2 gap-1.5 w-full place-items-center">{renderWordPage('who')}</div>
                        </div>
                        <div className="bg-green-50 rounded-2xl p-2 md:p-3 border-t-8 border-green-300 shadow-sm flex flex-col items-center">
                            <div className="w-full flex items-center justify-between mb-2">
                                <h2 className="text-green-700 text-sm font-bold bg-green-200 px-3 py-0.5 rounded-full">地点</h2>
                                <button onClick={() => handleRefreshCategory('place')} className="flex items-center gap-1 text-[10px] md:text-xs text-green-700 bg-green-100 hover:bg-green-200 px-2 py-1 rounded-full transition-colors font-bold shadow-sm active:scale-95"><RefreshCw className="w-3 h-3" /> 换一批</button>
                            </div>
                            <div className="grid grid-cols-2 gap-1.5 w-full place-items-center">{renderWordPage('place')}</div>
                        </div>
                        <div className="bg-red-50 rounded-2xl p-2 md:p-3 border-t-8 border-red-300 shadow-sm flex flex-col items-center">
                            <div className="w-full flex items-center justify-between mb-2">
                                <h2 className="text-red-700 text-sm font-bold bg-red-200 px-3 py-0.5 rounded-full">动作</h2>
                                <button onClick={() => handleRefreshCategory('action')} className="flex items-center gap-1 text-[10px] md:text-xs text-red-700 bg-red-100 hover:bg-red-200 px-2 py-1 rounded-full transition-colors font-bold shadow-sm active:scale-95"><RefreshCw className="w-3 h-3" /> 换一批</button>
                            </div>
                            <div className="grid grid-cols-2 gap-1.5 w-full place-items-center">{renderWordPage('action')}</div>
                        </div>
                    </div>

                    <div className="max-w-5xl mx-auto w-full bg-white rounded-3xl p-3 md:p-6 shadow-xl border-4 border-orange-100 relative flex flex-col flex-shrink-0 mt-2 pb-6">
                        <div className="absolute -top-10 -right-10 w-32 h-32 bg-yellow-100 rounded-full opacity-50 pointer-events-none"></div>
                        <div className="absolute -bottom-10 -left-10 w-40 h-40 bg-blue-100 rounded-full opacity-50 pointer-events-none"></div>

                        <div className={`mb-2 p-2 md:p-3 rounded-2xl flex items-center gap-2 transition-colors duration-500 z-10 flex-shrink-0 ${feedback.type === 'success' ? 'bg-green-100 text-green-800 border border-green-200' : feedback.type === 'hint' ? 'bg-orange-100 text-orange-800 border border-orange-200' : feedback.type === 'warning' ? 'bg-red-100 text-red-800 border border-red-200' : 'bg-gray-50 text-gray-600 border border-gray-200'}`}>
                            <div className="flex-shrink-0">{feedback.icon}</div>
                            <span className="font-bold text-sm md:text-base leading-tight">{feedback.text}</span>
                        </div>

                        <div className="flex flex-wrap md:flex-nowrap items-center justify-center gap-1.5 md:gap-3 my-auto z-10 py-2">
                            <div className="flex flex-col items-center animate-pulse">
                                <div className="bg-gradient-to-r from-orange-400 to-red-500 w-16 h-16 md:w-20 md:h-20 rounded-xl rounded-tr-2xl rounded-bl-lg shadow-lg flex items-center justify-center border-4 border-red-600 relative">
                                    <div className="absolute -top-4 left-1 text-gray-400 text-xs">💨</div>
                                    <div className="absolute -top-6 left-4 text-gray-300 text-sm">☁️</div>
                                    <TrainFront className="text-white w-8 h-8 md:w-10 md:h-10" />
                                    <div className="absolute -bottom-2.5 left-1.5 w-5 h-5 bg-gray-800 rounded-full border-2 border-gray-400"></div>
                                    <div className="absolute -bottom-2.5 right-1.5 w-5 h-5 bg-gray-800 rounded-full border-2 border-gray-400"></div>
                                </div>
                            </div>

                            {trainSlots.map((slot, index) => (
                                <div key={`slot-${index}`} className="flex items-center">
                                    <div className="w-1.5 h-3 bg-gray-400 rounded-full mx-0.5 md:mx-1"></div>
                                    <div 
                                        className={`relative w-20 h-24 md:w-24 md:h-28 rounded-xl transition-all duration-300 ease-in-out flex flex-col items-center ${slot ? 'bg-white border-0' : 'bg-gray-50 border-4 border-dashed border-gray-300 hover:border-purple-400 hover:bg-purple-50 cursor-pointer'} ${selectedItem && !slot ? 'animate-pulse border-purple-500 bg-purple-50' : ''}`}
                                        onDragOver={handleDragOver}
                                        onDrop={(e) => handleDrop(e, index)}
                                        onClick={() => !slot && handleEmptySlotClick(index)}
                                    >
                                        {slot ? (
                                            <div className="absolute inset-0">{renderCard(slot, 'slot', index)}</div>
                                        ) : (
                                            <div className="absolute inset-0 flex items-center justify-center text-gray-400 text-3xl font-bold opacity-30">?</div>
                                        )}
                                        <div className="absolute -bottom-2.5 left-2 w-5 h-5 bg-gray-700 rounded-full border-2 border-gray-300 z-0"></div>
                                        <div className="absolute -bottom-2.5 right-2 w-5 h-5 bg-gray-700 rounded-full border-2 border-gray-300 z-0"></div>
                                    </div>
                                </div>
                            ))}
                        </div>

                        <div className="flex flex-col md:flex-row items-center justify-between mt-4 md:mt-6 bg-purple-50 p-3 md:p-4 rounded-2xl border border-purple-100 z-10 flex-shrink-0">
                            <div className="flex-1 flex items-center gap-3 w-full mb-2 md:mb-0 overflow-x-auto min-w-0 pr-2 md:pr-4">
                                <button 
                                    onClick={speakSentenceAI}
                                    disabled={trainSlots.filter(Boolean).length === 0}
                                    className={`flex-shrink-0 text-white p-2.5 rounded-full shadow-md transition-colors ${
                                        ttsStatus === 'playing' ? 'bg-pink-500 animate-pulse' : 
                                        ttsStatus === 'loading' ? 'bg-purple-400' : 'bg-purple-500 hover:bg-purple-600 disabled:bg-gray-300'
                                    }`}
                                    title={ttsStatus === 'idle' ? "读出句子" : "停止朗读"}
                                >
                                    {ttsStatus === 'loading' ? <Spinner className="w-6 h-6" /> : <Volume2 className="w-6 h-6" />}
                                </button>
                                <div className="text-xl md:text-2xl font-bold text-gray-700 whitespace-nowrap overflow-hidden text-ellipsis">
                                    {formatSentence(trainSlots, true)}
                                </div>
                            </div>

                            <button 
                                onClick={resetTrain}
                                className="flex-shrink-0 flex items-center gap-1.5 px-5 py-2.5 bg-white text-orange-500 text-sm font-bold rounded-full shadow-sm hover:shadow-md hover:bg-orange-50 border border-orange-200 transition-all"
                            >
                                <RotateCcw className="w-5 h-5" />
                                <span>清空重放</span>
                            </button>
                        </div>
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
